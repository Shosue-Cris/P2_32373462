<!-- Sección Contacto -->
<section id="contact" class="py-16 bg-primary-800 text-white">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12"><%= __('index.menu.opcion4') %></h2>
        <div class="flex flex-col lg:flex-row gap-12">
            <div class="lg:w-1/2">
                <h3 class="text-2xl font-semibold mb-6"><%= __('index.contactInfo') %></h3>
                <div class="space-y-4">
                    <p class="flex items-center">
                        <i class="fas fa-map-marker-alt text-secondary-500 mr-4 text-xl"></i>
                        <span><%= __('index.address') %></span>
                    </p>
                    <p class="flex items-center">
                        <i class="fas fa-phone text-secondary-500 mr-4 text-xl"></i>
                        <span>+58 412 123 4567</span>
                    </p>
                    <p class="flex items-center">
                        <i class="fas fa-envelope text-secondary-500 mr-4 text-xl"></i>
                        <span>hola@valerysgreen.com</span>
                    </p>
                    <p class="flex items-center">
                        <i class="fas fa-clock text-secondary-500 mr-4 text-xl"></i>
                        <span><%= __('index.schedule') %></span>
                    </p>
                </div>
                <div class="mt-8">
                    <h4 class="text-xl font-semibold mb-4"><%= __('index.followUs') %></h4>
                    <div class="flex space-x-4">
                        <a href="#" class="bg-white text-primary-700 hover:bg-primary-100 w-10 h-10 rounded-full flex items-center justify-center transition-colors">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="bg-white text-primary-700 hover:bg-primary-100 w-10 h-10 rounded-full flex items-center justify-center transition-colors">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="bg-white text-primary-700 hover:bg-primary-100 w-10 h-10 rounded-full flex items-center justify-center transition-colors">
                            <i class="fab fa-tiktok"></i>
                        </a>
                        <a href="#" class="bg-white text-primary-700 hover:bg-primary-100 w-10 h-10 rounded-full flex items-center justify-center transition-colors">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="lg:w-1/2">
                <form id="formulario" class="bg-white text-gray-800 p-6 rounded-lg shadow-lg">
                    <div class="mb-4">
                        <label for="nombre" class="block text-gray-700 font-medium mb-2"><%= __('index.name') %></label>
                        <input type="text" id="nombre" name="nombre" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                    </div>
                    <div class="mb-4">
                        <label for="email" class="block text-gray-700 font-medium mb-2">Email</label>
                        <input type="email" name="email" id="email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" placeholder="<%= __('index.emailPlaceholder') %>">
                    </div>
                    <div class="mb-4">
                        <label for="comentario" class="block text-gray-700 font-medium mb-2"><%= __('index.message') %></label>
                        <textarea name="comentario" id="comentario" required rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" placeholder="<%= __('index.reservationDetails') %>"></textarea>
                    </div>
                    <div class="mb-4">
                        <div class="g-recaptcha" data-sitekey="<%=sitioKey%>"></div>
                    </div>
                    <button type="submit" class="w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-3 px-6 rounded-lg transition-colors">
                        <%= __('index.sendReservation') %>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
</main>

