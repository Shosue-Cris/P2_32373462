<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta property="og:title" content="<%=title%>">
    <meta property="og:description" content="<%=description%>">
    <meta property="og:image" content="<%=imageUrl%>">
    <meta property="og:url" content="<%=pageUrl%>">
    <link rel="stylesheet" href="css/estilos.css">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <!-- Google tag (gtag.js) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            100: '#e6f7e6',
                            200: '#b3e6b3',
                            300: '#80d480',
                            400: '#4dc34d',
                            500: '#1ab11a',
                            600: '#169816',
                            700: '#117f11',
                            800: '#0d660d',
                            900: '#084d08',
                        },
                        secondary: {
                            500: '#8bc34a',
                            600: '#7cb342'
                        }
                    }
                }
            }
        }
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7LDM2VCZHJ"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-7LDM2VCZHJ');
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .food-card {
            transition: all 0.3s ease;
        }
        .food-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .menu-section {
            background-image: url('https://images.unsplash.com/photo-1544025162-d76694265947?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            position: relative;
        }
        .menu-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.9);
        }
    </style>
</head>
<body class="bg-green-50">
    <header class="bg-white shadow-md sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <!-- Logo -->
            <div class="flex items-center">
                <h1 class="text-2xl font-bold text-primary-600">
                    Valery's <span class="text-primary-800">Green</span>
                </h1>
                <p class="ml-2 text-sm text-primary-400 hidden sm:block">Comida que nutre el alma</p>
            </div>

            <!-- Menú para móvil -->
            <button 
                class="md:hidden text-primary-600 focus:outline-none"
                aria-label="Abrir menú"
                onclick="document.querySelector('.main-nav').classList.toggle('hidden')"
            >
                <i class="fas fa-bars text-2xl"></i>
            </button>

            <!-- Navegación principal -->
            <nav class="main-nav hidden md:block">
                <ul class="flex flex-col md:flex-row md:items-center space-y-2 md:space-y-0 md:space-x-6">
                    <li>
                        <a href="#home" class="text-primary-600 hover:text-primary-800 font-medium transition-colors px-2 py-1 rounded hover:bg-primary-50">
                            Inicio
                        </a>
                    </li>
                    <li>
                        <a href="#menu" class="text-primary-600 hover:text-primary-800 font-medium transition-colors px-2 py-1 rounded hover:bg-primary-50">
                            Menú
                        </a>
                    </li>
                    <li>
                        <a href="#about" class="text-primary-600 hover:text-primary-800 font-medium transition-colors px-2 py-1 rounded hover:bg-primary-50">
                            Nosotros
                        </a>
                    </li>
                    <li>
                        <a href="/getPayment" class="text-primary-600 hover:text-primary-800 font-medium transition-colors px-2 py-1 rounded hover:bg-primary-50">
                            Reservas
                        </a>
                    </li>
                    <li>
                        <a href="/admin/contacts" class="text-primary-600 hover:text-primary-800 font-medium transition-colors px-2 py-1 rounded hover:bg-primary-50">
                            Contacto
                        </a>
                    </li>
                    <li>
                        <a href="/login" class="bg-primary-100 text-primary-700 hover:bg-primary-200 font-medium transition-colors px-3 py-2 rounded-md">
                            Login
                        </a>
                    </li>
                    <% if(isAdmin){ %>
                    <li>
                        <a href="/logout" class="bg-red-100 text-red-600 hover:bg-red-200 font-medium transition-colors px-3 py-2 rounded-md">
                            Logout
                        </a>
                    </li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <!-- Sección Home -->
        <section id="home" class="py-20 bg-gradient-to-r from-primary-100 to-secondary-500">
            <div class="container mx-auto px-4 flex flex-col md:flex-row items-center">
                <div class="md:w-1/2 mb-10 md:mb-0">
                    <h2 class="text-4xl font-bold text-primary-800 mb-4">Delicias naturales para cada ocasión</h2>
                    <p class="text-lg text-gray-700 mb-6">Descubre nuestros platos saludables preparados con ingredientes frescos y orgánicos, pensados para cuidar tu salud sin sacrificar el sabor.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="#menu" class="bg-primary-600 hover:bg-primary-700 text-white font-medium py-3 px-6 rounded-lg transition-colors text-center">
                            Ver Menú
                        </a>
                        <a href="#contact" class="bg-white text-primary-600 hover:bg-primary-50 font-medium py-3 px-6 rounded-lg transition-colors text-center border border-primary-600">
                            Reservar Mesa
                        </a>
                    </div>
                </div>
                <div class="md:w-1/2">
                    <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Plato saludable" class="rounded-lg shadow-xl w-full h-auto max-h-96 object-cover">
                </div>
            </div>
        </section>

        <!-- Sección Menú -->
        <section id="menu" class="py-16 menu-section relative">
            <div class="container mx-auto px-4 relative z-10">
                <h2 class="text-3xl font-bold text-center text-primary-800 mb-12">Nuestros Platos Destacados</h2>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

                    <a href="/payment" class="food-card bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-all duration-300">
                        <div class="h-64 overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Ensalada de quinoa" class="w-full h-full object-cover">
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold text-primary-700 mb-2">Ensalada Superfood</h3>
                            <p class="text-gray-600 mb-4">Quinoa, aguacate, kale, arándanos y aderezo de limón.</p>
                            <div class="flex justify-between items-center">
                                <span class="text-primary-600 font-bold">$12.99</span>
                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">Disponible</span>
                            </div>
                        </div>
                    </a>

                    <a href="/payment" class="food-card bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-all duration-300">
                        <div class="h-64 overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1490645935967-10de6ba17061?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Buddha Bowl" class="w-full h-full object-cover">
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold text-primary-700 mb-2">Buddha Bowl</h3>
                            <p class="text-gray-600 mb-4">Arroz integral, garbanzos, vegetales asados y tahini.</p>
                            <div class="flex justify-between items-center">
                                <span class="text-primary-600 font-bold">$14.50</span>
                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">Disponible</span>
                            </div>
                        </div>
                    </a>

                    <a href="/payment" class="food-card bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-all duration-300">
                        <div class="h-64 overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1601050690597-df0568f70950?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Wrap vegetal" class="w-full h-full object-cover">
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold text-primary-700 mb-2">Wrap Verde</h3>
                            <p class="text-gray-600 mb-4">Tortilla integral con hummus, espinacas y vegetales frescos.</p>
                            <div class="flex justify-between items-center">
                                <span class="text-primary-600 font-bold">$10.99</span>
                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">Disponible</span>
                            </div>
                        </div>
                    </a>

                    <a href="/payment" class="food-card bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-all duration-300">
                        <div class="h-64 overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1505576399279-565b52d4ac71?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Smoothie bowl" class="w-full h-full object-cover">
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold text-primary-700 mb-2">Smoothie Bowl</h3>
                            <p class="text-gray-600 mb-4">Mezcla de frutas, granola y semillas de chía.</p>
                            <div class="flex justify-between items-center">
                                <span class="text-primary-600 font-bold">$9.99</span>
                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">Disponible</span>
                            </div>
                        </div>
                    </a>

                    <a href="/payment" class="food-card bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-all duration-300">
                        <div class="h-64 overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1606787366850-de6330128bfc?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Avocado toast" class="w-full h-full object-cover">
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold text-primary-700 mb-2">Avocado Toast</h3>
                            <p class="text-gray-600 mb-4">Pan integral, aguacate, semillas y huevo pochado.</p>
                            <div class="flex justify-between items-center">
                                <span class="text-primary-600 font-bold">$11.50</span>
                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">Disponible</span>
                            </div>
                        </div>
                    </a>

                    <a href="/payment" class="food-card bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-all duration-300">
                        <div class="h-64 overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1559847844-5315695dadae?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Hamburguesa vegana" class="w-full h-full object-cover">
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold text-primary-700 mb-2">Burger Vegana</h3>
                            <p class="text-gray-600 mb-4">Hamburguesa de lentejas con pan integral y vegetales.</p>
                            <div class="flex justify-between items-center">
                                <span class="text-primary-600 font-bold">$13.75</span>
                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">Disponible</span>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="text-center mt-12">
                    <a href="/full-menu" class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-medium py-3 px-8 rounded-lg transition-colors">
                        Ver Menú Completo
                    </a>
                </div>
            </div>
        </section>

        <!-- Sección Nosotros -->
        <section id="about" class="py-16 bg-primary-50">
            <div class="container mx-auto px-4">
                <div class="flex flex-col md:flex-row items-center">
                    <div class="md:w-1/2 mb-10 md:mb-0 md:pr-10">
                        <h2 class="text-3xl font-bold text-primary-800 mb-6">Nuestra Filosofía</h2>
                        <p class="text-gray-700 mb-4">En Valery's Green creemos que la comida saludable no tiene por qué ser aburrida. Nuestro chef ejecutivo Valery Martínez combina técnicas culinarias innovadoras con los ingredientes más frescos para crear experiencias gastronómicas que nutren el cuerpo y el alma.</p>
                        <p class="text-gray-700 mb-6">Trabajamos directamente con agricultores locales para garantizar la máxima frescura y apoyar a nuestra comunidad.</p>
                        <ul class="space-y-3">
                            <li class="flex items-center">
                                <i class="fas fa-leaf text-secondary-500 mr-3"></i>
                                <span>Ingredientes 100% orgánicos</span>
                            </li>
                            <li class="flex items-center">
                                <i class="fas fa-seedling text-secondary-500 mr-3"></i>
                                <span>Productos locales de temporada</span>
                            </li>
                            <li class="flex items-center">
                                <i class="fas fa-heart text-secondary-500 mr-3"></i>
                                <span>Preparado con amor y conciencia</span>
                            </li>
                        </ul>
                    </div>
                    <div class="md:w-1/2">
                        <div class="grid grid-cols-2 gap-4">
                            <div class="rounded-lg overflow-hidden h-48">
                                <img src="https://images.unsplash.com/photo-1606787366850-de6330128bfc?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Chef preparando comida" class="w-full h-full object-cover">
                            </div>
                            <div class="rounded-lg overflow-hidden h-48">
                                <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Vegetales frescos" class="w-full h-full object-cover">
                            </div>
                            <div class="rounded-lg overflow-hidden h-48">
                                <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Interior del restaurante" class="w-full h-full object-cover">
                            </div>
                            <div class="rounded-lg overflow-hidden h-48">
                                <img src="https://images.unsplash.com/photo-1550583724-b2692b85b150?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Jugos frescos" class="w-full h-full object-cover">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sección Galería -->
        <section id="gallery" class="py-16 bg-white">
            <div class="container mx-auto px-4">
                <h2 class="text-3xl font-bold text-center text-primary-800 mb-12">Nuestros Platos</h2>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    <div class="gallery-item relative overflow-hidden rounded-lg h-48">
                        <img src="https://images.unsplash.com/photo-1606787366850-de6330128bfc?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Avocado toast" class="w-full h-full object-cover transition-transform hover:scale-110">
                        <div class="absolute inset-0 bg-black bg-opacity-30 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity">
                            <p class="text-white font-medium">Avocado Toast</p>
                        </div>
                    </div>
                    <div class="gallery-item relative overflow-hidden rounded-lg h-48">
                        <img src="https://images.unsplash.com/photo-1559847844-5315695dadae?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Hamburguesa vegana" class="w-full h-full object-cover transition-transform hover:scale-110">
                        <div class="absolute inset-0 bg-black bg-opacity-30 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity">
                            <p class="text-white font-medium">Burger Vegana</p>
                        </div>
                    </div>
                    <div class="gallery-item relative overflow-hidden rounded-lg h-48">
                        <img src="https://images.unsplash.com/photo-1579584425555-c3ce17fd4351?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Sushi vegano" class="w-full h-full object-cover transition-transform hover:scale-110">
                        <div class="absolute inset-0 bg-black bg-opacity-30 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity">
                            <p class="text-white font-medium">Sushi Vegano</p>
                        </div>
                    </div>
                    <div class="gallery-item relative overflow-hidden rounded-lg h-48">
                        <img src="https://images.unsplash.com/photo-1505576399279-565b52d4ac71?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Açaí bowl" class="w-full h-full object-cover transition-transform hover:scale-110">
                        <div class="absolute inset-0 bg-black bg-opacity-30 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity">
                            <p class="text-white font-medium">Açaí Bowl</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sección Contacto -->
        <section id="contact" class="py-16 bg-primary-800 text-white">
            <div class="container mx-auto px-4">
                <h2 class="text-3xl font-bold text-center mb-12">Reserva tu Mesa</h2>
                <div class="flex flex-col lg:flex-row gap-12">
                    <div class="lg:w-1/2">
                        <h3 class="text-2xl font-semibold mb-6">Información de Contacto</h3>
                        <div class="space-y-4">
                            <p class="flex items-center">
                                <i class="fas fa-map-marker-alt text-secondary-500 mr-4 text-xl"></i>
                                <span>Av. Gourmet 123, Distrito Saludable</span>
                            </p>
                            <p class="flex items-center">
                                <i class="fas fa-phone text-secondary-500 mr-4 text-xl"></i>
                                <span>+58 412 123 4567</span>
                            </p>
                            <p class="flex items-center">
                                <i class="fas fa-envelope text-secondary-500 mr-4 text-xl"></i>
                                <span>hola@valerysgreen.com</span>
                            </p>
                            <p class="flex items-center">
                                <i class="fas fa-clock text-secondary-500 mr-4 text-xl"></i>
                                <span>Lunes a Sábado: 8am - 10pm<br>Domingo: 9am - 8pm</span>
                            </p>
                        </div>
                        <div class="mt-8">
                            <h4 class="text-xl font-semibold mb-4">Síguenos</h4>
                            <div class="flex space-x-4">
                                <a href="#" class="bg-white text-primary-700 hover:bg-primary-100 w-10 h-10 rounded-full flex items-center justify-center transition-colors">
                                    <i class="fab fa-facebook-f"></i>
                                </a>
                                <a href="#" class="bg-white text-primary-700 hover:bg-primary-100 w-10 h-10 rounded-full flex items-center justify-center transition-colors">
                                    <i class="fab fa-instagram"></i>
                                </a>
                                <a href="#" class="bg-white text-primary-700 hover:bg-primary-100 w-10 h-10 rounded-full flex items-center justify-center transition-colors">
                                    <i class="fab fa-tiktok"></i>
                                </a>
                                <a href="#" class="bg-white text-primary-700 hover:bg-primary-100 w-10 h-10 rounded-full flex items-center justify-center transition-colors">
                                    <i class="fab fa-whatsapp"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="lg:w-1/2">
                        <form id="formulario" class="bg-white text-gray-800 p-6 rounded-lg shadow-lg">
                            <div class="mb-4">
                                <label for="nombre" class="block text-gray-700 font-medium mb-2">Nombre</label>
                                <input type="text" id="nombre" name="nombre" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                            </div>
                            <div class="mb-4">
                                <label for="email" class="block text-gray-700 font-medium mb-2">Email</label>
                                <input type="email" name="email" id="email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" placeholder="tucorreo@ejemplo.com">
                            </div>
                            <div class="mb-4">
                                <label for="comentario" class="block text-gray-700 font-medium mb-2">Mensaje</label>
                                <textarea name="comentario" id="comentario" required rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" placeholder="¿Para cuántas personas y a qué hora?"></textarea>
                            </div>
                            <div class="mb-4">
                                <div class="g-recaptcha" data-sitekey="<%=sitioKey%>"></div>
                            </div>
                            <button type="submit" class="w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-3 px-6 rounded-lg transition-colors">
                                Enviar Reservación
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="bg-primary-900 text-white py-12">
        <div class="container mx-auto px-4">
            <div class="grid md:grid-cols-3 gap-8 mb-8">
                <div>
                    <h3 class="text-xl font-bold mb-4">Valery's Green</h3>
                    <p class="mb-4">Comida saludable, sabrosa y consciente para todos los días.</p>
                    <p>&copy; 2025 Valery's Green. Todos los derechos reservados.</p>
                </div>
                <div>
                    <h3 class="text-xl font-bold mb-4">Enlaces Rápidos</h3>
                    <ul class="space-y-2">
                        <li><a href="#home" class="hover:text-secondary-400 transition-colors">Inicio</a></li>
                        <li><a href="#menu" class="hover:text-secondary-400 transition-colors">Menú</a></li>
                        <li><a href="#about" class="hover:text-secondary-400 transition-colors">Nosotros</a></li>
                        <li><a href="#gallery" class="hover:text-secondary-400 transition-colors">Galería</a></li>
                        <li><a href="#contact" class="hover:text-secondary-400 transition-colors">Contacto</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-xl font-bold mb-4">Newsletter</h3>
                    <p class="mb-4">Suscríbete para recibir nuestras promociones y novedades.</p>
                    <form class="flex">
                        <input type="email" placeholder="Tu email" class="px-4 py-2 rounded-l-lg focus:outline-none text-gray-800 w-full">
                        <button type="submit" class="bg-secondary-500 hover:bg-secondary-600 px-4 py-2 rounded-r-lg transition-colors">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>
            <div class="pt-8 border-t border-primary-700 text-center">
                <p>Hecho con <i class="fas fa-heart text-red-400"></i> para amantes de la comida saludable</p>
            </div>
        </div>
    </footer>

    <script src="/js/fetch.js"></script>
    <script src="js/main.js"></script>
    <script>
        // Cerrar menú al hacer clic en un enlace (para móviles)
        document.querySelectorAll('.main-nav a').forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth < 768) {
                    document.querySelector('.main-nav').classList.add('hidden');
                }
            });
        });
    </script>
</body>
</html>