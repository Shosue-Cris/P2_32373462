        <a href="/login?form=login" class="bg-primary-100 text-primary-700 hover:bg-primary-200 font-medium transition-colors px-3 py-2 rounded-md">
          <%=__('index.menu.opcion6')%> 
      </a>
  </li>
  <% if(isAdmin){ %>
  <li>
    <a href="/logout" class="bg-red-100 text-red-600 hover:bg-red-200 font-medium transition-colors px-3 py-2 rounded-md">
      <%=__('index.menu.opcion7')%>  
  </a>
</li>
<% } %>
<li>

  <a href="/?lang=es" class="hover:text-blue-600 font-medium transition-colors duration-200">
    🇪🇸 Español
</a>
<span class="text-gray-400">|</span>
<a href="/?lang=en" class="hover:text-blue-600 font-medium transition-colors duration-200">
    🇺🇸 English
</a>

</li>
</ul>
</nav>
</div>
</header>


