<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Pagos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.3s ease-out forwards;
        }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body class="bg-gray-50 font-sans">
   <header class="bg-white shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">
    <div class="flex items-center">
      <h1 class="text-2xl font-bold text-blue-600">
        <%= __('brand.name') %><span class="text-blue-800"><%= __('brand.highlight') %></span>
      </h1>
      <p class="ml-2 text-sm text-blue-400 hidden sm:block"><%= __('brand.tagline') %></p>
    </div>

    <button
      class="md:hidden text-blue-600 focus:outline-none"
      aria-label="<%= __('menu.toggle') %>"
      onclick="document.querySelector('.main-nav').classList.toggle('hidden')"
    >
      <i class="fas fa-bars text-2xl"></i>
    </button>

    <nav class="main-nav hidden md:block">
      <ul class="flex flex-col md:flex-row md:items-center space-y-2 md:space-y-0 md:space-x-6">
        <% ['home','services','spaces','payments','contact','login'].forEach(key => { %>
          <li><a href="<%= __('nav.'+key+'_href') %>" class="text-blue-600 hover:text-blue-800 font-medium transition-colors px-2 py-1 rounded hover:bg-blue-50"><%= __('header.nav.'+key) %></a></li>
        <% }) %>
        <% if(isAdmin){ %>
        <li><a href="<%= __('nav.logout_href') %>" class="bg-red-100 text-red-600 hover:bg-red-200 font-medium transition-colors px-3 py-2 rounded-md"><%= __('header.nav.logout') %></a></li>
        <% } %>
      </ul>
    </nav>
  </div>
</header>

<div class="text-center mb-4">
    <a href="/getPayment?lang=es" class="hover:text-blue-600 font-medium transition-colors duration-200">
      🇪🇸 Español
    </a>
    <span class="text-gray-400">|</span>
    <a href="/getPayment?lang=en" class="hover:text-blue-600 font-medium transition-colors duration-200">
      🇺🇸 English
    </a>
  </div>

<div class="container mx-auto px-4 py-8">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6">
    <div class="flex items-center gap-3 mb-4 md:mb-0">
      <h1 class="text-2xl md:text-3xl font-bold text-gray-800">
        <i class="fas fa-credit-card text-blue-500 mr-2"></i> <%= __('payments.title') %>
      </h1>
    </div>
    <div class="flex items-center gap-2 bg-blue-50 px-4 py-2 rounded-full">
      <span class="text-xl font-semibold text-blue-600"><%= datePayments.length %></span>
      <span class="text-gray-600"><%= __('payments.transactions') %></span>
    </div>
  </div>

  <form id="filterForm" class="mb-8 bg-white p-6 rounded-xl shadow-sm border border-gray-200">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="md:col-span-2">
        <label for="searchInput" class="block text-sm font-medium text-gray-700 mb-1"><%= __('filters.search') %></label>
        <input id="searchInput" type="text" placeholder="<%= __('filters.placeholder') %>" class="...">
      </div>

      <div>
        <label for="estadoSelect" class="..."><%= __('filters.status') %></label>
        <select id="estadoSelect" class="...">
          <option value=""><%= __('status.all') %></option>
          <option value="aprobado"><%= __('status.approved') %></option>
          <option value="rechazado"><%= __('status.rejected') %></option>
          <option value="pendiente"><%= __('status.pending') %></option>
        </select>
      </div>

      <div>
        <label for="servicioSelect" class="..."><%= __('filters.service') %></label>
        <select id="servicioSelect" class="...">
          <option value=""><%= __('services.all') %></option>
          <option value="monthly"><%= __('services.monthly') %></option>
          <option value="annual"><%= __('services.annual') %></option>
        </select>
      </div>

      <div>
        <label for="fechaInicio" class="..."><%= __('filters.from') %></label>
        <input type="date" id="fechaInicio" class="...">
      </div>

      <div>
        <label for="fechaFin" class="..."><%= __('filters.to') %></label>
        <input type="date" id="fechaFin" class="...">
      </div>
    </div>
  </form>

  <div id="contactsContainer" class="bg-white rounded-xl shadow-sm overflow-hidden border">
    <% if (datePayments.length > 0) { %>
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr class="text-gray-500 text-sm font-medium">
              <% ['holder','email','card','expiry','amount','description','reference','date'].forEach(col => { %>
                <th class="px-6 py-3"><%= __('payments.table.'+col) %></th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% datePayments.forEach(payment => { 
                 const date = new Intl.DateTimeFormat(locale).format(new Date(payment.createdAt));
                 const time = new Intl.DateTimeFormat(locale, {hour:'2-digit', minute:'2-digit'}).format(new Date(payment.createdAt));
                 const number = new Intl.NumberFormat(locale, {style:'currency',currency: payment.currency}).format(payment.amount);
            %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4"><%= payment.nombreTitular %></td>
              <td class="px-6 py-4"><a href="mailto:<%= payment.correo %>"><%= payment.correo %></a></td>
              <td class="px-6 py-4">•••• •••• •••• <%= payment.cardNumber.slice(-4) %></td>
              <td class="px-6 py-4 text-gray-600"><%= payment.expMonth %>/<%= payment.expYear.toString().slice(-2) %></td>
              <td class="px-6 py-4"><%= number %></td>
              <td class="px-6 py-4 text-gray-600 line-clamp-2"><%= payment.descripcion %></td>
              <td class="px-6 py-4 text-gray-600 font-mono"><%= payment.reference %></td>
              <td class="px-6 py-4 text-sm text-gray-500"><div><%= date %></div><div class="text-xs"><%= time %></div></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="md:hidden grid gap-4 p-4">
        <% datePayments.forEach(payment => { 
             const date = new Intl.DateTimeFormat(locale).format(new Date(payment.createdAt));
             const time = new Intl.DateTimeFormat(locale, {hour:'2-digit', minute:'2-digit'}).format(new Date(payment.createdAt));
             const number = new Intl.NumberFormat(locale, {style:'currency',currency: payment.currency}).format(payment.amount);
        %>
        <div class="bg-white rounded-lg shadow border overflow-hidden">
          <div class="p-4 bg-gray-50 flex justify-between">
            <h3><%= payment.nombreTitular %></h3>
            <span class="<%= payment.estado === 'aprobado'? 'approved': payment.estado==='rechazado'? 'rejected': 'pending' %>"><%= __('status.'+payment.estado) %></span>
          </div>
          <div class="p-4 space-y-3">
            <div><strong><%= __('mobile.email') %></strong> <a href="mailto:<%= payment.correo %>"><%= payment.correo %></a></div>
            <div><strong><%= __('mobile.card') %></strong> •••• •••• •••• <%= payment.cardNumber.slice(-4) %></div>
            <div><strong><%= __('mobile.expires') %></strong> <%= payment.expMonth %>/<%= payment.expYear.toString().slice(-2) %></div>
            <div><strong><%= __('mobile.amount') %></strong> <%= number %></div>
            <div><strong><%= __('mobile.description') %></strong> <%= payment.descripcion %></div>
            <div><strong><%= __('mobile.reference') %></strong> <%= payment.reference %></div>
          </div>
          <div class="p-3 bg-gray-50 flex justify-between text-xs text-gray-500">
            <span><%= date %></span><span><%= time %></span>
          </div>
        </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-12">
        <h3 class="text-lg font-medium text-gray-900 mb-1"><%= __('empty.title') %></h3>
        <p class="text-gray-500"><%= __('empty.subtitle') %></p>
      </div>
    <% } %>
  </div>
</div>

    <script src="/js/filterPayment.js"></script>
    <script>
  // Cerrar menú al hacer clic en un enlace (para móviles)
  document.querySelectorAll('.main-nav a').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 768) {
        document.querySelector('.main-nav').classList.add('hidden');
      }
    });
  });
</script>
</body>
</html>